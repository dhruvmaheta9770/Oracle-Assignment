/* ASSIGNMENT QUERIES */

-- Display all records
SELECT * FROM student_duty;

-- Change the student class whose city is 'Surat'
UPDATE student_duty
SET class='C'
WHERE city='Surat';

-- Delete student records where percentage is less than 50
DELETE FROM student_duty
WHERE per<50;

-- Display unique classes
SELECT DISTINCT class
FROM student_duty;

-- Arrange table according to percentage
SELECT *
FROM student_duty
ORDER BY per;

-- Display the name of students starting with 'D'
SELECT *
FROM student_duty
WHERE s_num LIKE 'D%';

-- Display average percentage according to class
SELECT class, AVG(per) AS average_percentage
FROM student_duty
GROUP BY class;

-- Display records of students whose birth year is between 2004 and 2005
SELECT *
FROM student_duty
WHERE EXTRACT(YEAR FROM dob) BETWEEN 2004 AND 2005;

-- Display records of students belonging to Amreli and Class B
SELECT *
FROM student_duty
WHERE city='Amreli'
AND class='B';

-- Add mobile number column
ALTER TABLE student_duty
ADD mobile_no NUMBER(10);

