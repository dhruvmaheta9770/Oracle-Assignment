/* CREATE TABLE */

CREATE TABLE student_duty
(
    s_id NUMBER(3) PRIMARY KEY,
    s_num VARCHAR2(50),
    per NUMBER(5,2),
    class VARCHAR2(20),
    dob DATE,
    city VARCHAR2(30)
);

