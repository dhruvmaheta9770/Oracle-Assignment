-- ===========================================
-- ALTER TABLE EXERCISES
-- ===========================================

-- 1. Add Telephone column to Client Master
ALTER TABLE CLIENT_MASTER_2
ADD TELEPHONE NUMBER(10);

-- 2. Change size of SellPrice column to NUMBER(10,2)
ALTER TABLE PRODUCT_MASTER_2
MODIFY SELLPRICE NUMBER(10,2);

-- 3. Add Profit column to Product Master
ALTER TABLE PRODUCT_MASTER_2
ADD PROFIT NUMBER(12);

-- 4. Remove Profit column from Product Master
ALTER TABLE PRODUCT_MASTER_2
DROP COLUMN PROFIT;

-- 5. Rename Salesman Master table to SMAN_MAST
RENAME SALESMANMASTER_2 TO SMAN_MAST;

-- 6. Destroy Client Master table along with its data
DROP TABLE CLIENT_MASTER_2;

