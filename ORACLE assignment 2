-- ===========================================
-- RETRIEVAL QUERIES
-- ===========================================

-- 1. Names of all clients
SELECT NAME FROM CLIENT_MASTER_2;

-- 2. Entire Client Master table
SELECT * FROM CLIENT_MASTER_2;

-- 3. Name, City and State of all clients
SELECT NAME, CITY, STATE FROM CLIENT_MASTER_2;

-- 4. Products available
SELECT DESCRIPTION FROM PRODUCT_MASTER_2;

-- 5. Clients located in Mumbai
