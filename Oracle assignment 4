====================================================*/

CREATE TABLE CLIENT_MASTER_23
(
    CLIENTNO   VARCHAR2(6) PRIMARY KEY
               CHECK (CLIENTNO LIKE 'C%'),
    NAME       VARCHAR2(20) NOT NULL,
    ADDRESS1   VARCHAR2(30),
    ADDRESS2   VARCHAR2(30),
    CITY       VARCHAR2(15),
    PINCODE    NUMBER(8),
    STATE      VARCHAR2(15),
    BALDUE     NUMBER(10,2)
);

