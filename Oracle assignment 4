====================================================*/

CREATE TABLE SALESMAN_MASTER_23
(
    SALESMANNO    VARCHAR2(6) PRIMARY KEY
                  CHECK(SALESMANNO LIKE 'S%'),
    SALESMANNAME  VARCHAR2(20) NOT NULL,
    ADDRESS1      VARCHAR2(30) NOT NULL,
    ADDRESS2      VARCHAR2(30),
    CITY          VARCHAR2(20),
