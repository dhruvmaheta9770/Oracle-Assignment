    SALAMT        NUMBER(8,2) NOT NULL CHECK(SALAMT>0),
    TGTTOGET      NUMBER(6,2) NOT NULL CHECK(TGTTOGET>0),
    YTDSALES      NUMBER(6,2) NOT NULL CHECK(YTDSALES>0),
    REMARKS       VARCHAR2(60)
